# Project-specific ignores
# Ignore all files in data/ except .gitkeep
data/*
!data/.gitkeep

# Ignore all model weights/artifacts in models/ except .gitkeep
models/*
!models/.gitkeep

# Ignore generated reports/figures except .gitkeep
reports/figures/*
!reports/figures/.gitkeep

