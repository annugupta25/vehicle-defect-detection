# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Project-specific ignores
# Ignore all files in data/ except .gitkeep
data/*
!data/.gitkeep

# Ignore all model weights/artifacts in models/ except model.keras (<100MB) and .gitkeep
models/*
!models/.gitkeep
!models/model.keras

# Track generated reports figures in Git for README documentation
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# macOS specific
.DS_Store
.AppleDouble
.LSOverride
._*

# Environment and IDE settings
.env
.env.*
.vscode/
.idea/
*.swp
*.swo
